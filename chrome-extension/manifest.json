{
  "manifest_version": 3,
  "name": "Marvedge Action Capture",
  "version": "1.0.0",
  "description": "Captures mouse clicks, relative coordinates, and screen actions to generate automatic cinematic spring zooms.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["trustedHosts.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
