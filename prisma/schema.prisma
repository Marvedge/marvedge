generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  password       String?
  bio            String?
  location       String?
  website        String?
  plan           String          @default("FREE")
  sessionVersion Int             @default(0)
  accounts       Account[]
  Demo           Demo[]
  exportedVideos ExportedVideo[]
  reviews        Review[]
  sessions       Session[]
  tutorials      Tutorial[]      @relation("UserTutorials")
  videoJobs      VideoJob[]
  hubSettings    HubSettings?
  crmConnections CrmConnection[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// ACCOUNT DELETION AND THE CASCADE CHAIN (OVL PR 7)
// ---------------------------------------------------------------------------
// `Demo.user`, `ExportedVideo.user`, `VideoJob.user`, `Review.user` and
// `CtaClick.demo` carry an EXPLICIT `onDelete: Cascade` that they did not have
// before. Prisma defaults a REQUIRED relation to `Restrict`, not to anything
// intuitive, so every one of them was an `ON DELETE RESTRICT` foreign key in
// the database (see migrations 20250818150238_init, 20260310135638,
// 20260310163000 and 20260703000000_reconcile_schema_drift).
//
// That made `app/api/user/delete/route.ts` broken for any user who owned a
// demo: it deletes sessions and accounts by hand and then calls
// `prisma.user.delete()`, which raised a foreign-key violation and returned a
// 500. Nothing downstream ran. With the OVL models added in PRs 3-4 that stops
// being merely a broken button and becomes a privacy failure — a viewer's Lead
// row (name, email, company size, consent record) OUTLIVING the deletion of the
// account it was collected under is the worst bug this feature can ship.
//
// The overlay models themselves were never the problem: VideoOverlayConfig,
// Lead, PlayerEvent, LeadDelivery and CrmConnection all cascade correctly. The
// chain broke one link ABOVE them, which is exactly why PR 7 requires this to be
// verified by a test rather than by reading the file — see
// app/lib/overlays/cascade.ts and cascade.test.ts, which parse THIS file and
// fail if any edge below regresses.
//
// `View.demoId` / `View.exportedVideoId` stay SetNull, unchanged: a View row is
// an anonymous counter with no PII, and orphaning it preserves historical
// totals for the same reason PlayerEventDaily has no foreign key at all.
model Demo {
  id             String              @id @default(uuid())
  title          String
  description    String?
  videoUrl       String
  startTime      String?
  endTime        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  editing        Json?
  userId         String
  isPublic       Boolean             @default(false)
  publicLink     String?             @unique
  shareCount     Int                 @default(0)
  subtitles      Json?
  exportedUrl    String?
  duration       Float?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags           String[]            @default([])
  integrations   String[]            @default([])
  userRoles      String[]            @default([])
  featured       Boolean             @default(false)
  exportedVideo  ExportedVideo?
  videoJobs      VideoJob[]
  views          View[]
  ctas           Cta[]
  ctaClicks      CtaClick[]
  subtitleTracks SubtitleTrack[]
  audioClips     AudioClip[]
  overlayConfig  VideoOverlayConfig?
  leads          Lead[]
  playerEvents   PlayerEvent[]
}

model Tutorial {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  slides      Slide[]
  user        User     @relation("UserTutorials", fields: [userId], references: [id], onDelete: Cascade)
}

model Slide {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  clicks      Json?
  timestamp   Int
  createdAt   DateTime @default(now())
  tutorialId  String
  tutorial    Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
}

model View {
  id              String         @id @default(cuid())
  demoId          String?
  timestamp       DateTime       @default(now())
  duration        Int?
  exportedVideoId String?
  demo            Demo?          @relation(fields: [demoId], references: [id])
  exportedVideo   ExportedVideo? @relation(fields: [exportedVideoId], references: [id])
}

model VideoJob {
  id          String   @id @default(cuid())
  userId      String
  demoId      String?
  status      String   @default("PENDING")
  progress    Int      @default(0)
  videoUrl    String
  jobData     Json
  exportedUrl String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  demo        Demo?    @relation(fields: [demoId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExportedVideo {
  id             String   @id @default(cuid())
  title          String
  description    String?
  exportedUrl    String
  shareableUrl   String
  sourceVideoUrl String?
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  demoId         String?  @unique
  shareCount     Int      @default(1)
  demo           Demo?    @relation(fields: [demoId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  views          View[]

  // HLS renditions (OVL PR 8). NARROW COLUMNS, NOT `settings`, deliberately:
  // `settings` is a client-supplied blob that POST /api/exported-videos writes
  // wholesale on every save (`settings: settings ?? null`), so a playlist URL
  // parked in it would be erased by the next export — the same trap that kept
  // overlay config out of Demo.editing. These are also read by an
  // unauthenticated share page on every view, where a column is selectable and
  // indexable and a JSON path is neither.
  //
  // hlsPlaylistUrl is an `r2://bucket/object` URI, resolved to https by
  // app/lib/r2.ts's toHttpsUrl(). hlsSourceHash is what makes re-packaging
  // idempotent: the worker skips the encode when the source still hashes to it.
  hlsPlaylistUrl String?
  hlsSourceHash  String?
  hlsUpdatedAt   DateTime?

  @@index([userId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cta {
  id        String     @id @default(cuid())
  demoId    String
  label     String
  url       String
  placement String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  demo      Demo       @relation(fields: [demoId], references: [id], onDelete: Cascade)
  clicks    CtaClick[]

  @@index([demoId])
}

model CtaClick {
  id        String   @id @default(cuid())
  ctaId     String?
  demoId    String
  label     String
  pageType  String   @default("demo")
  sessionId String?
  userId    String?
  referrer  String?
  timestamp DateTime @default(now())
  cta       Cta?     @relation(fields: [ctaId], references: [id], onDelete: SetNull)
  demo      Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, timestamp])
  @@index([ctaId])
}

model HubSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  subdomain       String?  @unique
  customDomain    String?  @unique
  sslStatus       String   @default("pending") // pending, active, failed
  dnsVerification Json? // To store TXT/CNAME records for verification
  logoUrl         String?
  brandColor      String   @default("#7C5CFC")
  textColor       String   @default("#111827")
  accentColor     String   @default("#F3F0FC")
  hubTitle        String?
  hubDescription  String?
  cloudflareId    String? // Cloudflare custom hostname ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One subtitle track per (demo, language), holding the whole cue array as JSON.
///
/// Deliberately NOT the PRD's per-segment SubtitleSegment table: cues are always
/// read and written as a whole array, so per-segment rows would mean thousands of
/// inserts and a join on every render for no query benefit. See
/// Subtitle-Implementation-Plan.md section 3, decision 5.
model SubtitleTrack {
  id        String   @id @default(uuid())
  demoId    String
  language  String
  status    String   @default("READY")
  source    String   @default("stt") // stt | translation | manual
  cues      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  demo      Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@unique([demoId, language])
  @@index([demoId])
}

model AudioClip {
  id           String      @id @default(cuid())
  demoId       String
  demo         Demo        @relation(fields: [demoId], references: [id], onDelete: Cascade)
  originalKey  String
  trimmedKey   String?
  fileName     String
  mimeType     String
  durationSec  Float?
  trimStartSec Float       @default(0)
  trimEndSec   Float?
  order        Int         @default(0)
  status       AudioStatus @default(UPLOADING)
  error        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([demoId, order])
}

enum AudioStatus {
  UPLOADING
  PROCESSING
  READY
  TRIM_PROCESSING
  FAILED
}

// ---------------------------------------------------------------------------
// OVL — Interactive Video Overlays (GitHub #302)
// ---------------------------------------------------------------------------
// Overlay config lives here rather than in Demo.editing: `editing` is the
// editor's autosaved working draft and gets wholesale-overwritten on every save,
// whereas this row is read by an unauthenticated public page on every single
// view and must be a narrow, indexed record.
//
// ON DELETE, deliberately, per model:
//   VideoOverlayConfig · Cascade — config without its demo is meaningless.
//   Lead               · Cascade — `demoId` is required, so there is no "orphan"
//                        state to fall into. Deleting a demo therefore destroys
//                        the leads it captured, which is also the right privacy
//                        default: viewer PII must never outlive the thing it was
//                        collected for. Owners export to CSV before deleting.
//   PlayerEvent        · Cascade — raw telemetry follows its demo.
//   PlayerEventDaily   · NO foreign key, by design. The rollup is anonymous
//                        aggregate counts with no PII, and it must survive the
//                        demo so historical dashboard totals do not silently
//                        rewrite themselves when an old demo is deleted.

model VideoOverlayConfig {
  id         String   @id @default(cuid())
  demoId     String   @unique
  enabled    Boolean  @default(false)
  leadGate   Json?
  branching  Json?
  scheduling Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  demo       Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
}

model Lead {
  id          String         @id @default(cuid())
  demoId      String
  name        String
  email       String
  companySize String?
  sessionId   String?
  referrer    String?
  // The exact consent string that was on screen when this viewer ticked the box.
  // Stored per lead, never looked up from config, so a later reword of the copy
  // cannot retroactively misrepresent what someone agreed to.
  consentText String?
  consentAt   DateTime?
  createdAt   DateTime       @default(now())
  demo        Demo           @relation(fields: [demoId], references: [id], onDelete: Cascade)
  deliveries  LeadDelivery[]

  @@unique([demoId, email])
  @@index([demoId, createdAt])
}

model PlayerEvent {
  id              String   @id @default(cuid())
  demoId          String?
  // No foreign key: mirrors View.exportedVideoId usage on the /share/video/[id]
  // route, and keeps an event from a deleted export from failing the insert.
  exportedVideoId String?
  sessionId       String
  name            String
  positionSec     Float?
  meta            Json?
  timestamp       DateTime @default(now())
  demo            Demo?    @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, name, timestamp])
  @@index([sessionId])
}

model PlayerEventDaily {
  id     String   @id @default(cuid())
  demoId String
  name   String
  date   DateTime @db.Date
  count  Int      @default(0)

  @@unique([demoId, name, date])
  @@index([demoId, date])
}

// ---------------------------------------------------------------------------
// OVL — CRM delivery (PR 4)
// ---------------------------------------------------------------------------
// The outbound half of #302 §2.1. A captured Lead is forwarded to whatever the
// demo's OWNER has connected. "Workspace" in the issue = that User (locked
// decision 3): this repo has no Workspace/Team/membership model, and
// `CrmConnection.userId` is the one column that moves if one ever lands.
//
// CrmConnection.credentials is THE FIRST PER-USER SECRET THIS APP STORES.
// It is NEVER plaintext: app/lib/crm/crypto.ts wraps it in AES-256-GCM and what
// lands in this column is an envelope of { v, iv, tag, ct }. Nothing reads a
// decrypted credential back out to a route response or a log line.
//
// LeadDelivery is one row per (lead × connection) — the delivery ledger that
// stands in for a queue (locked decision 10: no BullMQ). `status` + `attempts` +
// `lastError` is what makes POST /api/v3/leads/retry idempotent: a retry looks
// for FAILED rows, and a row that already reads DELIVERED is never touched
// again, so calling the endpoint twice cannot deliver a lead twice.
//
// ON DELETE:
//   CrmConnection · Cascade from User — a deleted account takes its (encrypted)
//                   credentials with it. app/api/user/delete/route.ts relies on
//                   exactly this.
//   LeadDelivery  · Cascade from BOTH Lead and CrmConnection. A delivery record
//                   about a lead that no longer exists is a dangling reference
//                   to deleted PII, and a delivery to a disconnected CRM is
//                   unretryable — neither is worth keeping.

model CrmConnection {
  id          String         @id @default(cuid())
  userId      String
  /// "hubspot" | "salesforce" | "webhook" — see app/lib/crm/types.ts.
  provider    String
  /// ENCRYPTED AT REST. An AES-256-GCM envelope, never a plaintext credential.
  credentials Json
  /// Optional per-connection property/field overrides; provider-specific shape.
  fieldMap    Json?
  enabled     Boolean        @default(true)
  lastOkAt    DateTime?
  lastError   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  LeadDelivery[]

  @@index([userId])
}

model LeadDelivery {
  id           String        @id @default(cuid())
  leadId       String
  connectionId String
  /// PENDING | DELIVERED | FAILED — see app/lib/crm/state.ts.
  status       String        @default("PENDING")
  attempts     Int           @default(0)
  lastError    String?
  deliveredAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  connection   CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([leadId, connectionId])
  @@index([status, createdAt])
  @@index([leadId])
}
