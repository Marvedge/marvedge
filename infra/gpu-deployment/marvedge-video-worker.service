[Unit]
Description=Marvedge BullMQ Video & Dubbing Worker
After=network.target
Wants=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/marvedge
EnvironmentFile=/etc/marvedge/worker.env
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs video-worker/index.ts
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=marvedge-video-worker

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
