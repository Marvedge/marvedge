# =============================================================================
# Marvedge GPU Worker Environment File Template
# Path: /etc/marvedge/worker.env (Permissions: 0600, Owner: root/ec2-user)
# Generated dynamically via bootstrap script or SSM parameter injection
# =============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Shared Redis (Upstash / TLS Redis over standard TCP) ---
# Used by reframe-worker, video-worker, and Vercel Next.js producer
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_UPSTASH_ENDPOINT.upstash.io:6379"

# --- Callback Authentication ---
# Target Vercel deployment URL and shared HMAC callback secret
BACKEND_URL="https://marvedge.com"
CALLBACK_SECRET="YOUR_SHARED_CALLBACK_SECRET"

# --- Internal ML Service Gateway ---
REFRAME_ML_SERVICE_URL="http://127.0.0.1:8000"
REFRAME_ML_TIMEOUT_MS=180000
ML_GATEWAY_TOKEN="YOUR_INTERNAL_GATEWAY_TOKEN"

# --- Downstream Service Routing (for ML Gateway) ---
AUTOFILP_SERVICE_URL="http://127.0.0.1:8002"
TALKNET_SERVICE_URL="http://127.0.0.1:8001"

# --- Concurrency Guardrails (Task-00094: Strict Concurrency 1) ---
REFRAME_WORKER_CONCURRENCY=1
WORKER_CONCURRENCY=1

# --- TalkNet Model Checkpoint Paths ---
TALKNET_S3FD_WEIGHTS="/opt/marvedge/talknet/weights/sfd_face.pth"
TALKNET_MODEL_WEIGHTS="/opt/marvedge/talknet/weights/pretrain_TalkSet.model"
TALKNET_TIMEOUT_SEC=150
DOWNLOAD_TIMEOUT_SEC=60

# --- AutoFlip Binary & Graph Paths ---
AUTOFILP_BINARY_PATH="/usr/local/bin/run_autoflip_to_json"
AUTOFILP_GRAPH_PATH="/mediapipe/mediapipe/examples/desktop/autoflip/autoflip_headless_graph.pbtxt"
AUTOFILP_TIMEOUT_SEC=150

# --- AWS Storage & Video Processing ---
STORAGE_PROVIDER="aws"
AWS_REGION="ap-southeast-2"
RAW_BUCKET="marvedge-raw-ap2"
PROCESSED_BUCKET="marvedge-processed-ap2"

# --- Video Worker DB (PostgreSQL / RDS) ---
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_RDS_HOST.rds.amazonaws.com:5432/marvedge?sslmode=require"

# --- Cloudinary & ElevenLabs (Required for Video/Dubbing Worker) ---
CLOUDINARY_CLOUD_NAME="marvedge"
CLOUDINARY_API_KEY="YOUR_KEY"
CLOUDINARY_API_SECRET="YOUR_SECRET"
ELEVENLABS_API_KEY="YOUR_KEY"
