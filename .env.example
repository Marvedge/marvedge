# ---------------------------------------------------------------------------
# Marvedge — example environment. Copy to `.env` and fill in the values you need.
# Only DATABASE_URL + NEXTAUTH_* are required to boot the app.
# Everything below the "Optional integrations" line powers individual features
# (payments, email, video processing, uploads, AVS) and can stay blank until needed.
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) ---------------------------------------------------
# PostgreSQL connection string. Replace with your own local/hosted Postgres URL.
DATABASE_URL=""

# --- NextAuth (REQUIRED) ---------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional integrations — leave blank unless you are exercising that feature.
# ---------------------------------------------------------------------------

# Google OAuth (sign-in with Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay (payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Resend (transactional email: contact form, password reset)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
DEMO_REQUEST_TO_EMAIL=""

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_UPLOAD_PRESET=""

# Redis / BullMQ (background video jobs)
REDIS_URL=""

# Video processing worker / cloud backends
NEXT_PUBLIC_VIDEO_PROCESSING_BACKEND_URL=""
USE_GCP_WORKER=""
USE_AWS_SPLITTER=""
GCP_VIDEO_WORKER_URL=""
CALLBACK_SECRET=""

# Video Reframing (Task-00023)
# Dedicated lightweight worker and pure ML inference service configuration.
# The worker consumes BullMQ "reframe-processing", delegates ML inference to
# REFRAME_ML_SERVICE_URL over HTTP, and posts authenticated callbacks with CALLBACK_SECRET.
REFRAME_ML_SERVICE_URL="http://localhost:8000"
REFRAME_ML_TIMEOUT_MS="180000"
REFRAME_WORKER_CONCURRENCY="1"
REFRAME_CALLBACK_MAX_RETRIES="3"
REFRAME_CALLBACK_RETRY_DELAY_MS="1000"

# Deepgram (subtitles / transcription AND Aura text-to-speech for AVS voiceover).
# Server-only — never expose with a NEXT_PUBLIC_ prefix.
DEEPGRAM_API_KEY=""

# Google Cloud Storage (raw/processed video buckets)
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_CLIENT_EMAIL=""
GOOGLE_CLOUD_PRIVATE_KEY=""
GCP_RAW_BUCKET=""

# AWS (DynamoDB job progress + Lambda splitter)
AWS_REGION=""
AWS_SPLITTER_FUNCTION_NAME=""
DDB_TABLE=""

# ---------------------------------------------------------------------------
# AVS — AI Script, Voiceover & Audio Synchronization (PRO/ENTERPRISE only)
# ---------------------------------------------------------------------------

# OpenAI (AI script tone rewrite). Server-only — never expose to the browser.
OPENAI_API_KEY=""

# AVS master switch (server-only). Set to "true" to enable AVS server routes.
# For staging/QA, set this AND NEXT_PUBLIC_AVS_ENABLED to "true"; keep both blank
# in production until the feature is signed off.
AVS_ENABLED=""

# AVS UI panel switch (client-safe). Set to "true" to show the "AI Voice & Script"
# sidebar panel. Only shows for PRO/ENTERPRISE users.
NEXT_PUBLIC_AVS_ENABLED=""

# ---------------------------------------------------------------------------
# WTM — Automated Video Watermarking & Compositing
# ---------------------------------------------------------------------------
# Pure ffmpeg + the existing GCS/Cloud Run worker — no new vendor or key.
# FREE/anon exports get a forced Marvedge watermark; PRO/ENTERPRISE users can
# upload a custom logo, adjust opacity, or remove it, and get a circular camera
# bubble composited into the export. No-op when the flags are off (including the
# free-tier watermark).

# WTM master switch (server-only). Set to "true" to enable the watermark
# render/plan logic and the /api/wtm/composite camera-bubble pre-pass. Enabled on
# staging/QA (set this AND NEXT_PUBLIC_WTM_ENABLED to "true"); keep both blank in
# production until the feature is signed off.
WTM_ENABLED="true"

# WTM UI panel switch (client-safe). Set to "true" to show the "Branding" sidebar
# panel and the WYSIWYG watermark/bubble overlays on the editor preview.
NEXT_PUBLIC_WTM_ENABLED="true"

# Cloud Run worker only — camera-bubble compositing (all optional, sane
# defaults): output frame rate both inputs are normalized to, and the GCS prefix
# composited sources are written under.
# WTM_COMPOSITE_FPS="30"
# WTM_COMPOSITE_PREFIX="wtm-composite/"

# ---------------------------------------------------------------------------
# QR — Shareable-link QR codes
# ---------------------------------------------------------------------------
# A branded QR for a share link that already exists. Derived and read-only: it
# renders a URL, never mints one, writes nothing, and does not touch export.
# No new vendor or key — the only dependency is the qrcode-generator matrix lib.

# QR kill-switch (client-safe). UNLIKE the AVS and WTM flags above, this DEFAULTS
# TO ON when blank or unset — the surface is additive and cannot change existing
# export/share behaviour, so the flag exists to pull it during an incident rather
# than to roll it out. Only an explicit "false" or "0" disables it.
# NEXT_PUBLIC_SHARE_QR_ENABLED="false"

# ---------------------------------------------------------------------------
# SUB — AI Subtitle Generator
# ---------------------------------------------------------------------------
# Subtitle generation, editing, styling and SRT/VTT/TXT export are FREE for every
# plan. Only translation is PRO/ENTERPRISE, gated server-side from the user's real
# plan. No new vendor or key: speech-to-text is the existing Deepgram key held by
# the Cloud Run worker, and translation reuses OPENAI_API_KEY above.

# Subtitle editor panel switch (client-safe). Set to "true" to show the subtitle
# editing/timeline/style panel. Like the AVS and WTM flags (and UNLIKE the QR
# kill-switch above), this DEFAULTS TO OFF: the panel rewrites cues that get
# burned into an export, so "unset" must mean "behave exactly as today".
NEXT_PUBLIC_SUBTITLE_EDITOR_ENABLED=""

# Subtitle translation switch (server-only). Set to "true" to enable the AI
# translation route. Also defaults to off. This is the feature gate, not the
# paywall — the PRO/ENTERPRISE check is a separate server-side plan lookup.
SUBTITLE_TRANSLATE_ENABLED=""

# ---------------------------------------------------------------------------
# OVL — Interactive Video Overlays
# ---------------------------------------------------------------------------
# Lead-capture gate, branching cards and an inline scheduling widget rendered on
# the public share player, plus the player telemetry that feeds the overlay
# funnel. No new vendor or key for the capture side; CRM delivery adds only the
# customer's own credentials, which they mint in their own portal.
#
# UNLIKE the QR kill-switch above, these DEFAULT TO OFF when blank or unset. QR
# is derived and read-only; these change what an unauthenticated public page
# renders and cause viewer PII to be stored and forwarded. Off must mean the
# share routes render byte-identically to before the feature existed.

# OVL master switch (server-only). Set to "true" to enable /api/v3/events,
# /api/v3/config and the owner-facing overlay config routes. For staging/QA set
# this AND NEXT_PUBLIC_OVERLAYS_ENABLED to "true"; keep both blank in production
# until the feature is signed off.
OVERLAYS_ENABLED=""

# OVL UI switch (client-safe). Set to "true" to render the overlay layer on the
# share player and show the "Overlays" sidebar panel in the editor.
NEXT_PUBLIC_OVERLAYS_ENABLED=""

# Outbound CRM delivery (server-only). Independent of OVERLAYS_ENABLED on
# purpose: with this blank, leads are still captured and stored, they are simply
# not forwarded to HubSpot / Salesforce / the generic webhook. Pull this during a
# CRM incident without taking the lead gate down.
OVERLAYS_CRM_ENABLED=""

# CRM credential encryption key (server-only). base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# CrmConnection.credentials holds a customer's own HubSpot Private App token or
# webhook signing secret — the first per-user secret this app stores — and is
# encrypted with AES-256-GCM before it is written. THIS IS NOT OPTIONAL WHERE CRM
# DELIVERY IS USED: with the key absent, creating a connection fails with a 503
# rather than silently writing a plaintext credential to the database.
#
# ROTATION: move the current value to OVERLAYS_CRM_SECRET_KEY_PREVIOUS, put a
# fresh key here, deploy. Existing credentials still decrypt under the previous
# key and are re-encrypted under the new one the next time a connection is saved;
# drop the PREVIOUS value once every connection has been re-saved. There is no
# bulk re-encrypt job on purpose — a job that decrypts every credential in the
# database is a bigger liability than the two-key window it would save.
OVERLAYS_CRM_SECRET_KEY=""
OVERLAYS_CRM_SECRET_KEY_PREVIOUS=""

# ---------------------------------------------------------------------------
# OVL analytics: rollup endpoint and retention (PR 7)
# ---------------------------------------------------------------------------

# Shared secret for POST /api/v3/events/rollup, which rolls one UTC day of
# PlayerEvent rows into PlayerEventDaily and then applies the two retention
# windows below. base64 of 32 random bytes is plenty:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# It travels in the x-marvedge-rollup-secret HEADER, never a query parameter:
# query strings land in access logs, proxy logs and Referer headers, and this
# secret authorises row deletion.
#
# BLANK MEANS THE ENDPOINT IS CLOSED (503), not open. There is no scheduler in
# this repo by design — point a cron at it:
#   curl -X POST https://<host>/api/v3/events/rollup \
#        -H "x-marvedge-rollup-secret: $OVERLAYS_ROLLUP_SECRET" \
#        -H "content-type: application/json" -d '{"date":"2026-09-01"}'
# `date` is optional and defaults to yesterday (UTC). The call is idempotent:
# re-running a day overwrites its counts rather than doubling them.
OVERLAYS_ROLLUP_SECRET=""

# How long raw PlayerEvent rows are kept, in days. DEFAULT 90 when blank.
# Raw events are the high-volume half of the telemetry; the PlayerEventDaily
# rollup they feed is kept indefinitely and is what the analytics page reads, so
# deleting an event never deletes a counted funnel step. The rollup always runs
# BEFORE this sweep in the same request.
OVERLAYS_EVENT_RETENTION_DAYS=""

# How long a captured Lead is kept, in days. DEFAULT 730 — 24 months — when
# blank. This is a commitment to the person who filled in the form, not a cost
# control. Deleting a lead also deletes its LeadDelivery rows.
#
# A non-numeric or non-positive value in either variable FALLS BACK to the
# default rather than resolving to 0, which would delete everything older than
# this morning.
OVERLAYS_LEAD_RETENTION_DAYS=""

# ---------------------------------------------------------------------------
# OVL HLS packaging and signed media (PR 8)
# ---------------------------------------------------------------------------
# TWO SUB-FLAGS, NOT ONE, and neither is implied by OVERLAYS_ENABLED. They gate
# two independent things: producing adaptive renditions, and refusing to hand
# out the media URL until a lead has been submitted. Either is a sensible
# configuration without the other, and one switch would mean an incident in
# either taking down both. Both DEFAULT OFF.

# HLS packaging (server-only). Set to "true" to package renditions on export
# completion, expose the manual "Generate HLS" action, and prefer a packaged
# playlist over the progressive MP4 on the share page.
#
# OFF IS NOT "no renditions exist": an already-packaged demo just goes back to
# being served its MP4, which is the fallback path every demo takes today. That
# is what makes this safe to pull during an incident — it costs adaptive
# bitrate, not playback.
#
# The Cloud Run worker ALSO needs R2 credentials for this (see below); with the
# flag on and the worker unconfigured, packaging fails and the demo keeps
# playing its MP4.
OVERLAYS_HLS_ENABLED=""

# Signed media (server-only). Set to "true" and a demo with a HARD lead gate no
# longer has its media URL rendered into the public page at all: the player asks
# GET /api/v3/media/[demoId], which answers 403 until a Lead row exists for the
# viewer's mv_sid. This is the enforcement the hard gate has been missing since
# PR 3 — until now it held the UI and nothing else.
#
# IT IS STILL NOT DRM. Someone who submits the form once gets a real URL and can
# pass it on until it expires. What changes is that a viewer who never submitted
# anything cannot read the media.
#
# ONLY AFFECTS A HARD GATE. A soft gate is one the viewer may skip, so
# withholding the media behind it would silently make it a hard one.
#
# NEEDS R2: signing uses app/lib/r2.ts's presigner, so R2_* below must be set.
# A demo whose media still lives on a legacy gs:// URL cannot be signed and is
# served its public URL as before — gated or not. That is deliberate: breaking
# pre-migration demos to enforce a gate that was never enforceable on them would
# be a regression dressed up as a security fix.
OVERLAYS_SIGNED_MEDIA_ENABLED=""

# How long a signed media URL is valid, in seconds. DEFAULT 900 (15 min) when
# blank. Clamped to [60, 21600]: under a minute expires mid-video and stalls the
# player, and a URL that lasts a day is a public URL with extra steps. A
# non-numeric or non-positive value falls back to the default rather than
# resolving to 0, which would expire every URL on issue.
OVERLAYS_SIGNED_MEDIA_TTL_SECONDS=""

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible object storage)
# ---------------------------------------------------------------------------
# Already used by the audio-clips feature, which falls back to Cloudinary when
# these are blank. HLS packaging and signed media do NOT have a fallback: with
# these unset, packaging fails and the media endpoint answers 503 rather than
# handing out an unsigned URL for a gated demo.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_RAW_BUCKET=""

# Public https base URL for the R2 bucket (a Cloudflare custom domain, or the
# r2.dev subdomain). REQUIRED FOR HLS: an HLS playlist references its segments
# by RELATIVE URI, so the player fetches them from whatever host served the
# playlist. With this blank, toHttpsUrl() leaves the r2:// URI unresolved and
# resolveHlsPlaylistUrl() reports no playlist — the demo falls back to its MP4
# rather than failing to play.
R2_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Cloud Run worker env for HLS (set on the WORKER, not on the Next app)
# ---------------------------------------------------------------------------
# The worker writes renditions straight to R2, so it needs its own copy of the
# R2 credentials above plus:
#   R2_HLS_BUCKET          bucket the renditions go to (falls back to
#                          R2_PROCESSED_BUCKET)
#   HLS_PREFIX             default "hls/"
#   HLS_SEGMENT_SECONDS    default 4 — also the GOP length
#   HLS_FPS                default 30 — the constant frame rate every rendition
#                          is normalised to, which is what makes a frame-counted
#                          GOP the same duration in each rendition
# See cloudrun-worker/README.md.
