# ==============================================================================
# Marvedge — Environment Configuration Reference
# ==============================================================================
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values marked as REQUIRED.
#   3. Values marked OPTIONAL can be left blank until the feature is needed.
#   4. NEVER commit your .env file. It is in .gitignore.
#
# INFRASTRUCTURE PHILOSOPHY:
#   AWS is the primary cloud provider for all storage, database, and compute.
#   Google Cloud Storage is retained as a cold-standby fallback — it is NOT
#   active by default. To activate GCS fallback, set STORAGE_PROVIDER=gcs
#   and populate the GCS credential block. This should only happen in the
#   event of a critical AWS outage and must be reverted once AWS is restored.
#
# CREDENTIALS SECURITY:
#   - Never use the root AWS account for application credentials.
#   - For local development: authenticate with `aws login --profile marvedge`.
#     The CLI profile is sufficient; leave AWS_ACCESS_KEY_ID blank locally.
#   - For CI/CD and production containers: inject AWS_ACCESS_KEY_ID,
#     AWS_SECRET_ACCESS_KEY, and AWS_SESSION_TOKEN via your secrets manager
#     (AWS Secrets Manager, GitHub Actions Secrets, etc.).
#   - Credentials are valid for 12 hours via `aws login` and renewable for
#     90 days without re-authenticating in the browser.
#
# ==============================================================================


# ==============================================================================
# CORE — Required to boot the application
# ==============================================================================

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (sign-in with Google — this is authentication ONLY, not storage)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ==============================================================================
# DATABASE
# Primary:  AWS RDS for PostgreSQL (ap-southeast-2) — production standard
# Fallback: Neon serverless PostgreSQL — for local dev without RDS VPN access
#
# For production, use the RDS endpoint. For local development, use the Neon
# pooler URL or a local postgres://localhost:5432/marvedge instance.
# ==============================================================================

# PRODUCTION (AWS RDS — ap-southeast-2):
# DATABASE_URL="postgresql://marvedge:<password>@marvedge-db.cfggeg20sv42.ap-southeast-2.rds.amazonaws.com:5432/marvedge"

# LOCAL DEV (Neon pooler — or local Postgres):
DATABASE_URL=""


# ==============================================================================
# STORAGE PROVIDER — Controls which object storage backend is active
#
#   "aws" → AWS S3 (REQUIRED for production. Default.)
#   "gcs" → Google Cloud Storage (FALLBACK ONLY — activate only during AWS outage)
#
# Changing this value alone does NOT switch backends — you must also ensure
# the corresponding credential block below is fully populated.
# ==============================================================================
STORAGE_PROVIDER="aws"


# ==============================================================================
# AWS — PRIMARY CLOUD PROVIDER
# Account:  Marvedge Central (753369745408)
# Region:   ap-southeast-2 (Sydney)
# Project:  https://console.aws.amazon.com — Marvedge Central
#
# PROVISIONED RESOURCES (do not rename without updating infrastructure):
#   S3 Raw bucket:       marvedge-raw-ap2
#   S3 Processed bucket: marvedge-processed-ap2
#   DynamoDB recipes:    marvedge-recipes
#   DynamoDB chunks:     marvedge-chunks
#   RDS PostgreSQL 16:   marvedge-db.cfggeg20sv42.ap-southeast-2.rds.amazonaws.com
# ==============================================================================

AWS_REGION="ap-southeast-2"

# IAM Credentials
# LOCAL: Leave blank. Use `aws login --profile marvedge` for CLI auth.
# PRODUCTION / CI-CD: Inject these via your secrets manager. Do NOT hardcode.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# S3 Object Storage
RAW_BUCKET="marvedge-raw-ap2"
PROCESSED_BUCKET="marvedge-processed-ap2"

# DynamoDB — render job state (replaces Firestore)
RECIPES_COLLECTION="marvedge-recipes"
CHUNKS_COLLECTION="marvedge-chunks"
DDB_TABLE="marvedge-jobs"

# Lambda splitter (optional — leave blank until Lambda function is deployed)
USE_AWS_SPLITTER="false"
AWS_SPLITTER_FUNCTION_NAME=""


# ==============================================================================
# GOOGLE CLOUD STORAGE — FALLBACK ONLY
#
# !! DO NOT ACTIVATE IN PRODUCTION UNLESS AWS IS CRITICALLY UNAVAILABLE !!
#
# To activate: set STORAGE_PROVIDER=gcs above AND populate all three GCS
# credential fields below. Revert to STORAGE_PROVIDER=aws as soon as AWS
# is restored. GCP credentials are provisioned in project marvedge-1.
#
# If you are a new team member and do not have GCP credentials, leave this
# entire block blank — the application runs entirely on AWS.
# ==============================================================================

# Set STORAGE_PROVIDER=gcs to activate this block
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_CLIENT_EMAIL=""
GOOGLE_CLOUD_PRIVATE_KEY=""

# GCS bucket names (only used when STORAGE_PROVIDER=gcs)
GCP_RAW_BUCKET="marvedge-raw-us-fast"
GCP_PROCESSED_BUCKET="marvedge-processed-us-fast"
GCP_PROJECT_ID=""


# ==============================================================================
# VIDEO PROCESSING WORKER
#
# PRIMARY path:  EC2 GPU instance (g4dn.xlarge, ap-southeast-2)
# FALLBACK path: Local worker or GCP Cloud Run worker
#
# For production, set GCP_VIDEO_WORKER_URL to the EC2 private IP once the
# instance is running. For local development, leave as http://localhost:8080.
# ==============================================================================

USE_GCP_WORKER="true"
GCP_VIDEO_WORKER_URL="http://localhost:8080"
GCP_VIDEO_WORKER_TIMEOUT_MS="180000"

# AVS dubbing service override (blank = routes to GCP_VIDEO_WORKER_URL)
AVS_DUB_SERVICE_URL=""
CALLBACK_SECRET=""

# ML pipeline concurrency (see docs/GPU_COST_CONCURRENCY.md for sizing)
REFRAME_ML_SERVICE_URL="http://localhost:8000"
REFRAME_ML_TIMEOUT_MS="180000"
REFRAME_WORKER_CONCURRENCY="4"
REFRAME_CALLBACK_MAX_RETRIES="3"
REFRAME_CALLBACK_RETRY_DELAY_MS="1000"

# Internal ML gateway (Docker Compose — configure on ml-gateway container)
AUTOFILP_SERVICE_URL="http://autoflip:8000"
TALKNET_SERVICE_URL="http://talknet:8000"
AUTOFILP_TIMEOUT_SEC="150"
TALKNET_TIMEOUT_SEC="150"
GATEWAY_TIMEOUT_SEC="180"

# TalkNet model weights (host-mounted path)
TALKNET_S3FD_WEIGHTS="/app/weights/sfd_face.pth"
TALKNET_MODEL_WEIGHTS="/app/weights/pretrain_TalkSet.model"


# ==============================================================================
# JOB QUEUE — Redis / BullMQ
#
# LOCAL:      redis://localhost:6379
# PRODUCTION: redis://<aws-elasticache-primary-endpoint>:6379
#             (ElastiCache Redis 7.x — provision in ap-southeast-2)
# ==============================================================================
REDIS_URL=""


# ==============================================================================
# THIRD-PARTY SERVICES
# These are vendor-managed and not migrated to AWS. No fallback required.
# ==============================================================================

# Cloudinary (media CDN — video/image hosting and delivery)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_UPLOAD_PRESET=""

# Deepgram (speech-to-text transcription + Aura TTS for AVS voiceover)
# Server-only — NEVER expose with NEXT_PUBLIC_ prefix.
DEEPGRAM_API_KEY=""

# Resend (transactional email: contact form, password reset)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
DEMO_REQUEST_TO_EMAIL=""

# OpenAI (AI script tone rewrite — server-only)
OPENAI_API_KEY=""

# Groq (subtitle translation)
GROQ_API_KEY=""

# Gemini API
GEMINI_API_KEY=""

# ElevenLabs (dubbing API)
ELEVENLABS_API_KEY=""

# Razorpay (payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Cloudflare R2 (HLS packaging + signed media — S3-compatible, no AWS migration needed)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_RAW_BUCKET=""
R2_PUBLIC_BASE_URL=""


# ==============================================================================
# FEATURE FLAGS
# DEFAULT: all off unless documented otherwise.
# Toggle per environment — staging turns these on before production.
# ==============================================================================

# AVS — AI Script, Voiceover & Audio Synchronization (PRO/ENTERPRISE)
AVS_ENABLED=""
NEXT_PUBLIC_AVS_ENABLED=""

# WTM — Watermarking & Camera Bubble Compositing (defaults ON — pull to disable)
WTM_ENABLED="true"
NEXT_PUBLIC_WTM_ENABLED="true"

# SUB — AI Subtitle Generator
NEXT_PUBLIC_SUBTITLE_EDITOR_ENABLED=""
SUBTITLE_TRANSLATE_ENABLED=""

# OVL — Interactive Video Overlays
OVERLAYS_ENABLED=""
NEXT_PUBLIC_OVERLAYS_ENABLED=""
OVERLAYS_CRM_ENABLED=""
OVERLAYS_CRM_SECRET_KEY=""
OVERLAYS_CRM_SECRET_KEY_PREVIOUS=""
OVERLAYS_ROLLUP_SECRET=""
OVERLAYS_EVENT_RETENTION_DAYS=""
OVERLAYS_LEAD_RETENTION_DAYS=""

# OVL — HLS Packaging + Signed Media
OVERLAYS_HLS_ENABLED=""
OVERLAYS_SIGNED_MEDIA_ENABLED=""
OVERLAYS_SIGNED_MEDIA_TTL_SECONDS=""

# QR — Shareable-link QR codes (defaults ON — set "false" to disable)
# NEXT_PUBLIC_SHARE_QR_ENABLED="false"

# ---------------------------------------------------------------------------
# Monitoring alert evaluation
# ---------------------------------------------------------------------------
# Required alert thresholds. Tune these to the service SLOs for the deployment.
MONITORING_REFRAME_INFERENCE_LATENCY_THRESHOLD_SECONDS="10"
MONITORING_DUBBING_LATENCY_THRESHOLD_SECONDS="120"
MONITORING_REFRAME_FAILURE_RATE_THRESHOLD="0.2"
MONITORING_DUBBING_FAILURE_RATE_THRESHOLD="0.2"
MONITORING_REFRAME_QUEUE_DEPTH_THRESHOLD="100"
MONITORING_DUBBING_QUEUE_DEPTH_THRESHOLD="50"

# Failure rate uses failed / (completed + failed) over this many seconds.
# BullMQ's Redis-backed outcome metrics use one-minute buckets, so configure a
# whole-minute window. Counts are shared across workers and survive restarts;
# bucket boundaries make the window approximate by up to one minute, and the
# latest partial bucket may not be included until another outcome is recorded.
MONITORING_FAILURE_RATE_OBSERVATION_WINDOW_SECONDS="300"
MONITORING_FAILURE_RATE_MINIMUM_JOBS="10"

# Repeated firing events for the same alert are suppressed during this interval.
# Alert evaluation state is process-local and is not a distributed coordinator.
MONITORING_ALERT_COOLDOWN_SECONDS="300"

# Run `npm run monitoring:alerts` as exactly one dedicated long-running process.
MONITORING_ALERT_EVALUATION_INTERVAL_SECONDS="60"
